{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lan-observer.local/schema/dashboard-v1.json",
  "title": "LAN Observer dashboard template",
  "type": "object",
  "required": ["schemaVersion", "name", "orientation", "columns", "widgets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "orientation": { "enum": ["landscape", "portrait", "auto"] },
    "columns": { "type": "integer", "minimum": 1, "maximum": 12 },
    "gap": { "type": "integer", "minimum": 0, "maximum": 48 },
    "widgets": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "x", "y", "w", "h"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "type": { "enum": ["wan", "systems", "status", "clock"] },
          "title": { "type": "string", "maxLength": 50 },
          "x": { "type": "integer", "minimum": 1, "maximum": 12 },
          "y": { "type": "integer", "minimum": 1, "maximum": 20 },
          "w": { "type": "integer", "minimum": 1, "maximum": 12 },
          "h": { "type": "integer", "minimum": 1, "maximum": 12 },
          "options": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

